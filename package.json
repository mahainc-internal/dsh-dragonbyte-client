{
  "name": "@snapai/dsh-dragonbyte-client",
  "version": "0.4.0",
  "type": "module",
  "description": "Share the MCP servers on your own machine with a DSH tenant",
  "exports": {
    ".": "./src/desktop.mjs",
    "./host": "./src/host.mjs",
    "./client": "./client.js"
  },
  "bin": {
    "dsh-dragonbyte-host": "./src/host-main.mjs"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahainc-internal/dsh-dragonbyte-client.git"
  },
  "homepage": "https://github.com/mahainc-internal/dsh-dragonbyte-client#readme",
  "bugs": {
    "url": "https://github.com/mahainc-internal/dsh-dragonbyte-client/issues"
  },
  "keywords": [
    "mcp",
    "dsh",
    "modelcontextprotocol",
    "cli"
  ]
}
